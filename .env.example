# Copy to .env and fill in real values. Never commit .env.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time (Expo's
# built-in env support) — read the same way on both platforms via
# process.env.EXPO_PUBLIC_*. They are not secret once the app is built,
# consistent with the shared-token MVP auth used by the backend/agent too.

# The backend's signaling WebSocket. Use your PC's LAN IP (not localhost —
# that would mean the phone itself) when testing on a real device, e.g.
# ws://192.168.1.50:8080. Use wss://your-domain.com once deployed.
EXPO_PUBLIC_BACKEND_URL=ws://192.168.1.50:8080

# Must match the backend's AUTH_TOKEN exactly.
EXPO_PUBLIC_AUTH_TOKEN=change-me-to-a-long-random-string
