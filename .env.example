# Copy to .env. EXPO_PUBLIC_* vars are inlined into the app at build time,
# so only put non-secret values here.

# Your backend server. On a real phone during local testing use your PC's
# LAN IP (not localhost — that would mean the phone itself), e.g.
# http://192.168.1.50:8080. Use https://your-domain.com once deployed.
# Users can also change it from "Server settings" on the sign-in screen.
EXPO_PUBLIC_SERVER_URL=http://192.168.1.50:8080
